# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Editor / OS noise
.DS_Store
*.swp
*.swo
.pytest_cache/

# Local secrets and credentials (keep only an explicit example file)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.netrc
.pypirc
credentials*.json
*secret*
*token*.txt

# Lake build artifacts (do not check vendored Foundations' lake builds either)
.lake/
lake-manifest.json
*.olean
*.ilean

# Foundation validator scratch logs (regenerated per run)
**/.validate-logs/

# codex CLI internal marker file (zero bytes; per-environment)
/.codex

# Local agent, prompt, transcript, and review-harness state (any depth)
**/.codex/
**/.claude/
**/.cursor/
**/.aider*
**/.continue/
**/.specstory/
**/.windsurf/
/memory/
/prompts/
/reviews/
/skills/
**/transcripts/
**/rollout-*.jsonl
**/*.transcript*
**/CLAUDE.local.md
**/.claude.json
**/.codex_thread_id*
**/CODEX_RUNBOOK.md
**/codex_kickoff.md

# LaTeX build artifacts (paper/ and any latex-build subtrees)
build/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

